{
  "name": "pharos-agent-skill",
  "version": "1.0.0",
  "description": "A reusable on-chain Skill for AI agents on Pharos Network — exposed as an MCP server and an OpenAI function-calling toolset. Built for the Pharos Skill-to-Agent Dual Cascade Hackathon (Phase 1).",
  "type": "module",
  "license": "MIT",
  "bin": {
    "pharos-agent-skill": "dist/mcp-server.js"
  },
  "scripts": {
    "build": "tsc",
    "mcp": "tsx src/mcp-server.ts",
    "demo": "tsx src/openai-agent-demo.ts",
    "smoke": "tsx src/smoke.ts",
    "test": "node --import tsx --test test/*.test.ts"
  },
  "keywords": ["pharos", "mcp", "ai-agent", "skill", "onchain", "evm", "x402", "openai"],
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.0.4",
    "viem": "^2.21.0",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "openai": "^4.67.0",
    "tsx": "^4.19.0",
    "typescript": "^5.6.0",
    "@types/node": "^22.7.0"
  }
}
