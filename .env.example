# --- Pharos network (EVM-equivalent L1) ---
# Pharos Atlantic testnet (verified from docs.pharos.xyz)
PHAROS_RPC_URL=https://atlantic.dplabs-internal.com
PHAROS_CHAIN_ID=688689
PHAROS_EXPLORER_URL=https://atlantic.pharosscan.xyz
PHAROS_NATIVE_SYMBOL=PHRS

# --- Agent wallet ---
# A funded testnet key the agent uses to pay / transact on-chain.
# Generate a fresh key for the hackathon; fund it from the Pharos faucet/Discord.
# NEVER commit a real key. Read-only tools work without this.
PHAROS_PRIVATE_KEY=

# --- OpenAI (only needed to run the demo agent in src/openai-agent-demo.ts) ---
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
